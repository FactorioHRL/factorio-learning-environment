OPENAI_API_KEY=XXX
DEEPSEEK_API_KEY=XXX
DB_PASSWORD=XXX
ANTHROPIC_API_KEY=XXX
NEPTUNE_API_TOKEN=XXX
CLUSTER_NAME=XXX
GEMINI_API_KEY=XXX
TOGETHER_API_KEY=XXX
DEEPSEEK_API_KEY=XXX
OPEN_ROUTER_API_KEY=XXX
WANDB_API_KEY=XXX

# Database Configuration
# Options: "sqlite" (default) or "postgres"
FLE_DB_TYPE="sqlite"

# SQLite Configuration (used when FLE_DB_TYPE=sqlite or as fallback)
# If not set, defaults to .fle/data.db
SQLITE_DB_FILE=".fle/data.db"

# Inspect evaluation defaults (CLI flags take precedence).
# Use the provider/model identifier accepted by Inspect.
# FLE_MODEL=openai/<model-id>
# Select one task, or use FLE_TASKS instead for multiple tasks.
# FLE_ENV_ID=steel_plate_throughput
# FLE_TASKS=iron_ore_throughput,iron_plate_throughput
# FLE_TRAJECTORY_LENGTH=64
# FLE_REASONING_EFFORT=low
# FLE_REASONING_TOKENS=4096
# Maximum output tokens per response:
# FLE_MAX_TOKENS=8192
# Total input and output tokens per sample:
# FLE_TOKEN_LIMIT=250000

# PostgreSQL Configuration (only needed when FLE_DB_TYPE=postgres)
SKILLS_DB_HOST=XXX
SKILLS_DB_PORT=XXX
SKILLS_DB_NAME=XXX
SKILLS_DB_USER=XXX
SKILLS_DB_PASSWORD=XXX

# AWS credentials if wanting to use Cloudformation, NOT REQUIRED
AWS_SECRET_ACCESS_KEY=<KEY>
AWS_ACCESS_KEY_ID=""
AWS_DEFAULT_REGION=""
CLUSTER_NAME=""
